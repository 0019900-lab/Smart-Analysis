{
  "name": "smart-analysis-desktop",
  "version": "0.20.0",
  "description": "Smart-Analysis",
  "author": "Timaxo <timaxo.apps@gmail.com>",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.mjs",
    "start": "node prepare.mjs && electron .",
    "dist": "node prepare.mjs && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.13.0"
  },
  "build": {
    "appId": "com.timaxo.smartanalysis",
    "productName": "Smart-Analysis",
    "copyright": "Coded by islam saad",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "smart",
        "name": "Smart-Analysis Project",
        "description": "Smart-Analysis Project",
        "icon": "icon.ico",
        "role": "Editor"
      },
      {
        "ext": "statlab",
        "name": "StatLab Project (old)",
        "description": "StatLab Project",
        "icon": "icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart-Analysis",
      "runAfterFinish": true,
      "license": "build/license.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "artifactName": "Smart-Analysis-Setup-${version}.${ext}"
    }
  }
}
